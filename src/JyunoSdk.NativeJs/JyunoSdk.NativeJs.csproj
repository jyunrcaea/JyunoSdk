<Project Sdk="Microsoft.NET.Sdk">

  <!-- Jyuno 코드를 JavaScript로 변환 (Native JS). 분석은 Jyuno 라이브러리(Jyuno.Analysis)를 사용 -->
  <PropertyGroup>
    <RootNamespace>JyunoSdk.NativeJs</RootNamespace>
    <PackageId>JyunoSdk.NativeJs</PackageId>
    <Description>Jyuno 스크립트를 런타임이 포함된 JavaScript 코드(Native JS)로 변환합니다. 브라우저나 Node.js에서 .NET 없이 실행할수 있습니다.</Description>
    <PackageTags>jyuno;javascript;transpiler;native-js</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Runtime\jyuno-runtime.js" LogicalName="JyunoSdk.NativeJs.jyuno-runtime.js" />
  </ItemGroup>

  <ItemGroup Condition="'$(JyunoSource)' == ''">
    <PackageReference Include="Jyuno" Version="$(JyunoVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(JyunoSource)' != ''">
    <ProjectReference Include="$(JyunoSourcePath)" />
  </ItemGroup>

</Project>
