<Project Sdk="Microsoft.NET.Sdk">

  <!-- jyuno 명령어: 대화형 프롬프트(REPL), 파일 실행, 검사, 언어 서버 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- 어셈블리 이름을 jyuno로 하면 Jyuno 패키지와 deps.json에서 이름이 겹치므로, 실행 파일 이름은 배포할 때 jyuno로 바꿈 -->
    <AssemblyName>JyunoSdk.Cli</AssemblyName>
    <RootNamespace>JyunoSdk.Cli</RootNamespace>
    <!-- dotnet tool install -g JyunoSdk 로 설치 -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jyuno</ToolCommandName>
    <PackageId>JyunoSdk</PackageId>
    <Description>Jyuno SDK: 대화형 Jyuno 프롬프트, 스크립트 실행/검사, Native JS(JavaScript) 변환, 그리고 Jyuno 언어 서버(LSP)를 제공하는 jyuno 명령어입니다.</Description>
    <PackageTags>jyuno;repl;language-server;lsp;sdk;javascript</PackageTags>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JyunoSdk.Analysis\JyunoSdk.Analysis.csproj" />
    <ProjectReference Include="..\JyunoSdk.LanguageServer\JyunoSdk.LanguageServer.csproj" />
    <ProjectReference Include="..\JyunoSdk.NativeJs\JyunoSdk.NativeJs.csproj" />
  </ItemGroup>

</Project>
