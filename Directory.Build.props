<Project>

  <!-- 모든 프로젝트에 공통으로 적용되는 설정 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.4.1</Version>
    <Authors>jyunrcaea</Authors>
    <Company>jyunrcaea</Company>
    <Product>JyunoSdk</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jyunrcaea/JyunoSdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jyunrcaea/JyunoSdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- NuGet에 보이는 README는 영어판(README.nuget.md). README.md를 고치면 같이 고쳐 주세요 -->
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- 모든 패키지(JyunoSdk, JyunoSdk.Analysis, JyunoSdk.LanguageServer, JyunoSdk.NativeJs)에 영어 README를 포함 -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.nuget.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    사용할 Jyuno 버전 (NuGet 패키지)
    로컬에서 고치고 있는 Jyuno 소스로 빌드하려면 JyunoSource에 Jyuno.csproj 경로를 넘기세요.
      dotnet build -p:JyunoSource=../Jyuno/Jyuno.csproj
  -->
  <PropertyGroup>
    <JyunoVersion>1.5.3</JyunoVersion>
    <JyunoSource></JyunoSource>
    <!-- 상대 경로는 이 파일(저장소 최상위) 기준 -->
    <JyunoSourcePath Condition="'$(JyunoSource)' != ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '$(JyunoSource)'))))</JyunoSourcePath>
  </PropertyGroup>

</Project>
